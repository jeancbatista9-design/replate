{
  "id": "/",
  "name": "RePlate — Your smart kitchen",
  "short_name": "RePlate",
  "description": "Eat it first. Waste less. Your personal food assistant.",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8f2",
  "theme_color": "#254f39",
  "icons": [
    {
      "src": "/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan a product",
      "url": "/#scan"
    },
    {
      "name": "My kitchen",
      "url": "/#kitchen"
    },
    {
      "name": "Shopping list",
      "url": "/#shopping"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
